{
  "expo": {
    "name": "Promarcos Clientes",
    "slug": "scanner-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mendesadvocacia",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nucleomendesadvocacia.promarcos",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para escanear documentos dos clientes com detecção automática de bordas",
        "NSPhotoLibraryUsageDescription": "Salvar documentos escaneados na galeria",
        "NSPhotoLibraryAddUsageDescription": "Salvar documentos escaneados na galeria",
        "NSLocationWhenInUseUsageDescription": "Registra a localização aproximada de ações de auditoria do colaborador",
        "NSMicrophoneUsageDescription": "Não utilizamos microfone, requerido apenas pelas dependências de câmera",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.nucleomendesadvocacia.promarcos",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "MANAGE_DOCUMENTS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E3A5F"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usado para escanear documentos dos clientes com detecção automática de bordas",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar imagens para anexar aos processos dos clientes"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Registra a localização aproximada de ações de auditoria do colaborador"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Salvar documentos escaneados na galeria",
          "savePhotosPermission": "Salvar documentos escaneados na galeria",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
